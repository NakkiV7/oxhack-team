# Server-only secrets. Copy to .env locally; never commit the filled file.
SPOTTR_GATEWAY_TOKEN=
GEMINI_API_KEY=
# Explicitly choose a text model enabled for your Gemini account.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=20000
HOST=127.0.0.1
PORT=8787

# Tiger PostgreSQL/TimescaleDB. Owner ID must match the installation shown in the app.
# Apply server/migrations/001_workouts.sql manually before the first explicit sync.
TIGER_DATABASE_URL=
SPOTTR_INSTALLATION_ID=

# Optional Snowflake SQL API check and pinned public PAMAP benchmark analytics.
# npm run snowflake:benchmark defaults to local dry-run without loading .env.
# Live import requires explicit --allow-live-public-data and existing resources;
# the CLI creates no database/schema/warehouse/table. See docs/snowflake-analytics.md.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
# Warehouse is optional for the fixed connection check, required for live analytics.
SNOWFLAKE_WAREHOUSE=
# Existing, case-correct identifiers required only for opted-in live analytics.
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional existing role, selected explicitly for every benchmark statement.
SNOWFLAKE_ROLE=

# Readiness placeholders only: these providers have no running gateway adapter.
PRESAGE_API_KEY=
VULTR_API_KEY=

# Voice implementation is owned by @MishaGitnik; placeholders for that branch.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional Delta/OpenRouter development token; not used by the app gateway.
OPENROUTER_API_KEY=
