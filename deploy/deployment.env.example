# Nonsecret deployment configuration. Copy to deployment.env, then edit privately.
SPOTTR_HOSTNAME=spottr.example.com
ACME_EMAIL=operator@example.com
# Space-separated client public IP/CIDR allowlist; loopback default denies outside clients.
# Use the phone/demo network's public egress address; never use 0.0.0.0/0 for this demo.
SPOTTR_ALLOWED_CIDRS=127.0.0.1/32 ::1/128
# Relative to deploy/compose.yaml. The example keeps config validation provider-free.
# Set ./gateway.env for deployment after configuring that private file.
SPOTTR_GATEWAY_ENV_FILE=./gateway.env.example
