# Private runtime values only. Copy to gateway.env and chmod 600.
# Set an existing owner bearer token privately; never share it with other installations.
SPOTTR_GATEWAY_TOKEN=
GEMINI_API_KEY=
# Explicit account-enabled text model, with no models/ prefix.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=20000

# Optional explicit sync, tied to the UUID shown by this installation's Sync card.
# Leave blank for a coaching-only demo. No startup migration occurs.
SPOTTR_INSTALLATION_ID=
TIGER_DATABASE_URL=

# If Tiger requires an additional trusted CA, mount a public CA bundle read-only
# and set NODE_EXTRA_CA_CERTS to its in-container path. Never disable TLS checks.
# Infrastructure/admin keys, Presage, ElevenLabs and Snowflake tokens are not needed.
