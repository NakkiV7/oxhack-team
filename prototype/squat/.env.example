# Optional. Copy to .env (gitignored) to turn on the AI coach and Q&A.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# PORT=3002

# Optional spoken coach (ElevenLabs). Lines are synthesised once and cached in voice_cache/.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=2EiwWnXFnvU5JabPnv8n
# Voices to offer when the key cannot list them (needs the voices_read permission): Name:voiceId,Name:voiceId
# ELEVENLABS_VOICES=Arnold:xxxxxxxxxxxxxxxxxxxx,Goggins:calmIdyyyyyyyyyyyyy+shoutingIdzzzzzzzzzz

# Tiger Data (PostgreSQL + TimescaleDB): every analysed frame and rep is streamed in once a second and the Tiger card
# on the page reads the rollups back. Strict TLS (verify-full) always; the team's service has a public CA.
TIGER_DATABASE_URL=
# Optional extra root for a service with a private CA, verified out of band. Never learned from the server.
# TIGER_CA_CERT=/absolute/path/to/verified-ca.pem
