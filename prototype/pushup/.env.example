# Optional. Copy to .env (gitignored) to turn on the AI coach and Q&A.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Tiger Data (Postgres + TimescaleDB) for rep history. Use your own connection string; never commit .env.
TIGER_DATABASE_URL=
# Whose reps to store and train on (any short text), and which rows to train on: mock,real or real
PUSHUP_USER_ID=local
# PUSHUP_SOURCES=mock,real

# Optional authenticated CA bundle, verified against official service/support provenance.
# Hostname and certificate-chain verification stay enabled with or without this setting.
# TIGER_CA_CERT=/absolute/path/to/verified-tiger-ca.pem
